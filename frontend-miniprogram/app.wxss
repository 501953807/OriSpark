/* app.wxss - Enhanced with premium design improvements */

page {
  /* More characterful font stack for Chinese web */
  font-family: 'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans GB', 'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  color: #374151;
  background-color: #f9fafb;
  line-height: 1.6;
}

/* Page title with tighter letter-spacing for prominence */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #111827;
  letter-spacing: -0.5px;
}

/* Loading state */
.loading-text {
  text-align: center;
  color: #6b7280;
  padding: 60rpx 0;
}

.error-state {
  text-align: center;
  color: #ef4444;
  padding: 60rpx 0;
}

.empty-text {
  text-align: center;
  color: #9ca3af;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  color: #6b7280;
  padding: 80rpx 24rpx;
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 0 20rpx;
  color: #111827;
  letter-spacing: -0.5px;
}

/* Button styles with active state feedback */
.btn-primary {
  background: linear-gradient(135deg, #059669, #047857);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

/* Active state on touch devices */
.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background: #fff;
  color: #059669;
  border: 2rpx solid #059669;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-secondary:hover {
  background: #f0fdf4;
}

.btn-secondary:active {
  transform: scale(0.98);
}

/* Card/component container with subtle shadow */
.card {
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
}

.card:hover {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  transform: translateY(-2rpx);
}

/* Container constraint */
.container {
  padding: 24rpx;
  max-width: 750rpx; /* Mobile-first, up to tablet width */
  margin: 0 auto;
}

/* Badge/tag styling */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 9999px;
  font-size: 20rpx;
  font-weight: 600;
}

.tag-primary {
  background: rgba(5, 150, 105, 0.1);
  color: #059669;
}

.tag-success {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

/* Icon placeholder for avatar/circle elements */
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d1d5db, #e5e7eb);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
}

/* Stats grid layout */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
}

.stat-item {
  text-align: center;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #059669;
  display: block;
}

.stat-label {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
